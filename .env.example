# Environment variables for RAG Chatbot

# Model Configuration
MODEL_NAME=google/flan-t5-small
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Device Configuration
# Options: cuda, cpu
DEVICE=cpu

# Retriever Configuration
K_BM25=5
K_FAISS=5
RETRIEVER_WEIGHTS_BM25=0.5
RETRIEVER_WEIGHTS_FAISS=0.5

# Reranker Configuration
RERANKER_TOP_K=6
RERANKER_FINAL_K=2

# Generation Configuration
MAX_NEW_TOKENS=512
MIN_LENGTH=50
TEMPERATURE=0.8

# LLM Pipeline Configuration
DO_SAMPLE=false

# Vectorstore Configuration
VECTORSTORE_PATH=vectorstore/index.faiss
VECTORSTORE_METADATA_PATH=vectorstore/metadata.pkl

# Data Configuration
DATA_DIR=data
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FORMAT=json

# Monitoring Configuration
ENABLE_MONITORING=true
ENABLE_QUERY_LOGGING=true
METRICS_EXPORT_INTERVAL=3600

# Testing Configuration
TEST_MODE=false
PYTEST_VERBOSITY=2

# Development Configuration
DEBUG_MODE=false
